/// 研究笔记
model ResearchNote {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  tsCode         String?   @map("ts_code") @db.VarChar(16)
  title          String    @db.VarChar(100)
  content        String    @db.Text
  tags           String[]  @default([])
  isPinned       Boolean   @default(false) @map("is_pinned")
  wordCount      Int       @default(0) @map("word_count")
  versionCount   Int       @default(1) @map("version_count")
  sourceRunId    String?   @map("source_run_id") @db.VarChar(32)
  sourceReportId String?   @unique(map: "research_notes_source_report_id_key") @map("source_report_id") @db.VarChar(32)
  thesis         String?   @db.Text
  risks          Json      @default("[]") @db.JsonB
  decision       String?   @db.Text
  outcome        String?   @db.Text
  reviewAt       DateTime? @map("review_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRun    AiAgentRun?       @relation("AiResearchReportJournalRun", fields: [sourceRunId], references: [id], onDelete: Restrict)
  sourceReport AiResearchReport? @relation("AiResearchReportJournal", fields: [sourceReportId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, tsCode])
  @@index([userId, isPinned])
  @@index([userId, deletedAt])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, sourceRunId])
  @@map("research_notes")
}
