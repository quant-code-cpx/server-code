PORT=3000
GLOBAL_PREFIX=api
NODE_ENV=development
PROCESS_ROLE=all                                  # api | agent-worker | scheduler | all；生产建议拆分
SCHEDULER_ENABLED=false                            # Agent 定时研究扫描器；仅 scheduler/all 角色启用
CRON_LOCK_PREFIX=quant:cron-lock                   # Redis 业务 Cron lease key 前缀
CRON_LOCK_TTL_MS=300000                            # lease 5 分钟；长任务会自动 heartbeat 续租
SHUTDOWN_GRACE_MS=5000                             # API 收到 SIGTERM/SIGINT 后保持 /ready=503 的摘流宽限期
AGENT_SCHEDULER_POLL_MS=60000
AGENT_SCHEDULER_LEASE_MS=120000
AGENT_SCHEDULER_BATCH_SIZE=100
AGENT_SCHEDULER_MAX_TASKS_PER_USER=50

# JWT Tokens（必填，建议使用 openssl rand -base64 48 生成随机值，长度不低于 32 字符）
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRE=43200                          # 12 小时（秒），Refresh Token 有效期
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRE=1800                            # 30 分钟（秒），Access Token 有效期

# CORS（生产环境配置前端域名，多个域名用逗号分隔；未配置时生产环境 CORS 禁用）
# 示例：CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=https://your-frontend-domain.com

# Redis（必填；使用至少 32 位 URL-safe 随机密码，ACL 由容器启动时生成）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_at_least_32_urlsafe_random_characters
REDIS_USERNAME=default

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/quant_db?schema=public"
AGENT_AUDIT_PAYLOAD_MODE=HASH_ONLY
# Agent Model Gateway（供应商全部从数据库加载；API key 只保存加密值）
AGENT_MODEL_CONFIG_SOURCE=database
AGENT_MODEL_PROVIDER=
# 可选多供应商 JSON array；设置后覆盖上方 legacy AGENT_MODEL_* 单供应商变量，key 仅放本机 .env/Secret Manager
AGENT_MODEL_PROVIDERS=
# 首次启动时若数据库为空，会将上面的 provider 导入 ai_model_providers；之后通过管理员 API 动态维护。
# 用于数据库中的 API key 加密。必须是至少 32 字符、稳定且独立的随机字符串，不能复用 JWT secret。
AGENT_MODEL_DB_ENCRYPTION_KEY=
# 仅首次从旧 ACCESS_TOKEN_SECRET fallback 迁移时设置；迁移成功后立即删除。
AGENT_MODEL_DB_ENCRYPTION_LEGACY_KEY=
AGENT_MODEL_BASE_URL=
AGENT_MODEL_BASE_URL_ALLOWLIST=
AGENT_MODEL_API_KEY=
AGENT_MODEL_DEFAULT=
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MODEL_MAX_RETRIES=2
AGENT_MODEL_RETRY_BASE_MS=200
AGENT_MODEL_CAPABILITIES=STREAMING,STRUCTURED_OUTPUT,TOOL_CALLING
AGENT_MODEL_CONTEXT_WINDOW=32768
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
AGENT_MODEL_REASONING_EFFORTS=LOW,MEDIUM,HIGH
AGENT_MODEL_DATA_CLASSES=PUBLIC,USER_PRIVATE,PORTFOLIO_SENSITIVE
AGENT_MODEL_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_MODEL_CIRCUIT_OPEN_MS=30000
# Agent observability（价格目录为每百万 token 成本的 JSON array；不含 key 或 Prompt）
AGENT_OBSERVABILITY_ENABLED=true
AGENT_OBSERVABILITY_TRACE_SAMPLE_RATE=1
AGENT_MODEL_PRICE_CATALOG_VERSION=unconfigured
AGENT_MODEL_PRICE_CATALOG=[]
# Agent 报告确认。生产必须使用 Secret Manager 中至少 32 字符的独立随机值。
AGENT_REPORT_STORAGE_DRIVER=local
AGENT_REPORT_STORAGE_LOCAL_PATH=/app/storage/agent-reports
AGENT_REPORT_CONFIRMATION_SECRET=
AGENT_REPORT_CONFIRMATION_TTL_SECONDS=600
# Agent Run / Event Store
AGENT_RUN_LEASE_MS=30000
AGENT_LEASE_HEARTBEAT_MS=10000
AGENT_EVENT_REPLAY_LIMIT=100
AGENT_RUN_FALLBACK_DURATION_MS=180000
AGENT_RUN_NON_MODEL_RESERVE_MS=60000
AGENT_RUN_MAX_DURATION_MS=10800000
AGENT_MAX_STEPS=32
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_PARALLEL_TOOLS=3
# 可选：跨多次模型调用的 Run 累计输入成本护栏；留空默认关闭。
# 这不是模型单次 context window，模型能力以部署配置快照为准。
AGENT_RUN_MAX_CUMULATIVE_INPUT_TOKENS=
AGENT_MAX_COST_PER_RUN=10
# Agent 模型感知上下文（比例均相对当前 Run 实际路由模型）
AGENT_PAGE_CONTEXT_MAX_BYTES=20000
AGENT_SUMMARY_ENABLED=true
AGENT_CONTEXT_SAFETY_RATIO=0.08
AGENT_CONTEXT_COMPACTION_TRIGGER_RATIO=0.75
AGENT_CONTEXT_COMPACTION_TARGET_RATIO=0.5
AGENT_CONTEXT_OUTPUT_RESERVE_RATIO=0.15
AGENT_SUMMARY_OUTPUT_RESERVE_RATIO=0.05
AGENT_SUMMARY_RUN_INPUT_RATIO=0.25
# 仅控制数据库分页大小，不参与压缩语义判断
AGENT_CONTEXT_QUERY_PAGE_SIZE=100
# Agent 报告/记忆检索。默认仅用 metadata + PostgreSQL FTS；Batch 027 no-go，不在生产启用 hybrid。
AGENT_RETRIEVAL_MODE=fts
AGENT_RETRIEVAL_MAX_HITS=5
AGENT_RETRIEVAL_FTS_CANDIDATES=50
AGENT_RETRIEVAL_FTS_WEIGHT=0.35
AGENT_RETRIEVAL_VECTOR_WEIGHT=0.65
AGENT_RETRIEVAL_CHUNK_CHARS=1200
AGENT_RETRIEVAL_CHUNK_OVERLAP_CHARS=160
# hybrid 试验专用；真实模型、allowlist、secret 和维度必须同时固定，禁止提交真实 key。
AGENT_RETRIEVAL_EMBEDDING_BASE_URL=
AGENT_RETRIEVAL_EMBEDDING_BASE_URL_ALLOWLIST=
AGENT_RETRIEVAL_EMBEDDING_API_KEY=
AGENT_RETRIEVAL_EMBEDDING_MODEL=
AGENT_RETRIEVAL_EMBEDDING_DIMENSIONS=
AGENT_RETRIEVAL_EMBEDDING_BATCH_SIZE=32
AGENT_RETRIEVAL_EMBEDDING_TIMEOUT_MS=15000
AGENT_RETRIEVAL_EMBEDDING_MAX_INPUT_CHARS=2000
AGENT_RETRIEVAL_HNSW_EF_SEARCH=80
AGENT_RETRIEVAL_IVFFLAT_PROBES=10
# Agent REST API 配额（生产环境必须显式配置）
AGENT_MAX_ACTIVE_RUNS_PER_USER=3
AGENT_DEFAULT_DAILY_BUDGET=20
AGENT_SSE_HEARTBEAT_MS=15000
AGENT_SSE_IDLE_TIMEOUT_MS=300000
AGENT_SSE_MAX_CONNECTIONS_PER_USER=3
AGENT_SSE_MAX_BUFFER_BYTES=1048576
# Agent BullMQ Worker（AGENT_QUEUE_REDIS_URL 为空时复用上方 Redis）
AGENT_QUEUE_REDIS_URL=
AGENT_QUEUE_PREFIX=quant:agent
AGENT_WORKER_CONCURRENCY=2
AGENT_JOB_TIMEOUT_MS=10860000
AGENT_JOB_ATTEMPTS=5
AGENT_JOB_BACKOFF_MS=2000
AGENT_RECONCILE_INTERVAL_MS=10000
AGENT_RECONCILE_BATCH_SIZE=100
# Agent durable notification delivery. Webhook 仅允许 HTTPS allowlist；密钥格式为 version:base64(32 bytes)，密文不回传。
NOTIFICATION_ENCRYPTION_KEYS=
NOTIFICATION_ENCRYPTION_ACTIVE_KEY_VERSION=1
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
NOTIFICATION_DELIVERY_TIMEOUT_MS=10000
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_BACKOFF_MS=2000
NOTIFICATION_DELIVERY_LEASE_MS=120000
NOTIFICATION_DELIVERY_RECONCILE_INTERVAL_MS=5000
NOTIFICATION_DELIVERY_RECONCILE_BATCH_SIZE=100
NOTIFICATION_WORKER_CONCURRENCY=2
# Agent Tool Registry / Executor（空 allowlist = 默认拒绝）
# 第二批可按灰度逐项加入：get_stock_chip_profile,get_stock_margin_history,get_stock_relative_strength,get_stock_events,get_stock_shareholder_profile
# 第三批可按灰度逐项加入：get_index_market_data,get_fund_research,get_industry_rotation,get_factor_analysis,get_macro_snapshot
# 第四批本地数据闸门通过后可加入：get_option_market,run_event_study
# 第五批须先运行组合事件账本/快照迁移与真库验收，通过后可加入：get_backtest_analytics,get_portfolio_analytics,save_research_report
# get_convertible_bond_market 须先完成历史全量回补；search_web/fetch_web_page 须先配置真实 Provider、API key 和 URL token secret。
AGENT_TOOLS_ENABLED=
AGENT_TOOL_MAX_CALLS_PER_RUN=20
AGENT_TOOL_DEFAULT_TIMEOUT_MS=10000
AGENT_TOOL_MAX_RESULT_BYTES=256000
AGENT_TOOL_MAX_CONCURRENT_PER_RUN=3
AGENT_TOOL_PRICE_MAX_BARS=5000
AGENT_TOOL_MARKET_CACHE_TTL_SECONDS=300
AGENT_TOOL_FINANCIAL_MAX_PERIODS=20
AGENT_TOOL_MONEYFLOW_MAX_DAYS=250
AGENT_QUANT_MAX_POINTS=10000
AGENT_VALUATION_MIN_SAMPLES=60
# 新回测必须使用 Batch 029 point-in-time 数据合同；生产保持 true。
BACKTEST_REQUIRE_VERIFIED_DATA=true
# Agent Web Search / Controlled Fetch（默认 disabled；真实 key 只放 secret/.env）
AGENT_SEARCH_PROVIDER=disabled
AGENT_SEARCH_API_KEY=
AGENT_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
AGENT_SEARCH_TIMEOUT_MS=10000
AGENT_FETCH_MAX_BYTES=1000000
AGENT_FETCH_MAX_REDIRECTS=3
AGENT_URL_TOKEN_SECRET=
AGENT_URL_TOKEN_TTL_SECONDS=900
PRISMA_CONNECTION_LIMIT=30                        # Prisma 连接池上限（生产建议 30-50）
PRISMA_POOL_TIMEOUT=20                            # 等待连接池空闲连接的秒数
PRISMA_CONNECT_TIMEOUT=10                         # 建立数据库连接的秒数
PRISMA_TRANSACTION_MAX_WAIT_MS=10000             # 事务排队等待连接的毫秒数
PRISMA_TRANSACTION_TIMEOUT_MS=30000              # 事务执行超时（毫秒）

# Tushare Pro（https://tushare.pro 注册后获取 token）
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_BASE_URL=http://api.tushare.pro
TUSHARE_TIMEOUT=10000
TUSHARE_REQUEST_INTERVAL_MS=350
TUSHARE_STK_FACTOR_MIN_INTERVAL_MS=650
TUSHARE_RATE_LIMIT_RETRY_DELAY_MS=65000
TUSHARE_MAX_RETRIES=3
TUSHARE_SYNC_ENABLED=false
TUSHARE_SYNC_START_DATE=19900101                  # 历史补数起始日期（YYYYMMDD）
TUSHARE_SYNC_CRON=0 30 18 * * *                  # 默认每天 18:30 触发，代码内会再判断是否交易日
TUSHARE_SYNC_TIME_ZONE=Asia/Shanghai

# 超级管理员初始化（首次启动时若数据库中无超级管理员则自动创建）
SUPER_ADMIN_ACCOUNT=superadmin
SUPER_ADMIN_PASSWORD=your_super_admin_password   # 不能少于8位
SUPER_ADMIN_NICKNAME=超级管理员

# Docker 数据目录（由 docker-compose.yml 强制从环境变量读取）
DATA_POSTGRES_DIR=../data/postgres
DATA_REDIS_DIR=../data/redis
DATA_REDIS_LOGS_DIR=../data/redis/logs

# 可观测性（HTTP 请求日志）
LOG_HTTP_REQUESTS=true                            # 是否记录 HTTP 请求日志（默认开启）
LOG_HTTP_BODY=false                               # 是否记录请求 Body（敏感字段自动脱敏，默认关闭）
LOG_OUTPUT=stdout                                 # stdout | file | both；生产默认 stdout JSON
APP_TMP_DIR=/app/tmp                              # 生产容器使用 tmpfs；开发可保留默认 tmp
REPORT_STORAGE_DIR=/app/storage/reports           # 单机 Compose 共享卷；多机必须切换对象存储
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium       # 生产镜像安装的系统 Chromium
REPORT_PDF_ENABLED=false                          # 默认关闭；仅安装 Chromium 且隔离运行的 report worker 可启用

# 生产模型网关。必须使用真实受信供应商 endpoint/key，不能使用 fake provider。
# AGENT_MODEL_PROVIDER=openai-compatible
# AGENT_MODEL_BASE_URL=https://models.example.com/v1
# AGENT_MODEL_BASE_URL_ALLOWLIST=https://models.example.com
# AGENT_MODEL_API_KEY=secret_from_secret_manager
# AGENT_MODEL_DEFAULT=approved-model-id
# AGENT_MODEL_CAPABILITIES=STREAMING,STRUCTURED_OUTPUT,TOOL_CALLING

# 生产 Compose 镜像与 Redis ACL（仅在 docker-compose.prod.yml 使用）
# 镜像必须是发布流水线生成的不可变 digest，禁止 latest。
APP_IMAGE_REF=registry.example.com/quant-server@sha256:replace_me
MIGRATION_IMAGE_REF=registry.example.com/quant-server-migration@sha256:replace_me
REDIS_IMAGE_REF=registry.example.com/quant-redis@sha256:replace_me
EDGE_IMAGE_REF=registry.example.com/quant-edge@sha256:replace_me
FRONTEND_DIST_PATH=
POSTGRES_IMAGE_REF=postgres@sha256:replace_me
APP_DATABASE_USERNAME=app_user
APP_DATABASE_PASSWORD=replace_with_at_least_32_random_characters
MIGRATION_DATABASE_USERNAME=migration_user
MIGRATION_DATABASE_PASSWORD=replace_with_at_least_32_random_characters
# URL credentials must match the two role variables above. Migration role owns schema changes;
# app role only receives DML/default privileges created by the migration role.
APP_DATABASE_URL=postgresql://app_user:replace_with_urlencoded_password@database:5432/quant_db?schema=public
REDIS_API_USERNAME=api
REDIS_API_PASSWORD=replace_with_urlsafe_random_secret
REDIS_WORKER_USERNAME=worker
REDIS_WORKER_PASSWORD=replace_with_urlsafe_random_secret
REDIS_SOCKET_USERNAME=socket
REDIS_SOCKET_PASSWORD=replace_with_urlsafe_random_secret
REDIS_OPS_USERNAME=ops
REDIS_OPS_PASSWORD=replace_with_urlsafe_random_secret
MIGRATION_DATABASE_URL=postgresql://migration_user:replace_with_urlencoded_password@database:5432/quant_db?schema=public
# 新闻时事模块（默认关闭；启用时 secret/token 必须替换）
NEWS_ENABLED=false
NEWS_AKSHARE_BRIDGE_ENABLED=false
NEWS_AKSHARE_BRIDGE_BASE_URL=http://news-source-bridge:8080
NEWS_AKSHARE_BRIDGE_ALLOWED_HOST=news-source-bridge
NEWS_AKSHARE_BRIDGE_TOKEN=replace-with-at-least-32-byte-random-token
NEWS_AKSHARE_BRIDGE_TIMEOUT_MS=60000
NEWS_GDELT_ENABLED=false
NEWS_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_GDELT_TIMEOUT_MS=60000
NEWS_GDELT_MIN_INTERVAL_MS=60000
NEWS_QUEUE_CONCURRENCY=4
NEWS_EXCERPT_MAX_CHARS=1000
NEWS_CURSOR_SECRET=replace-with-at-least-32-byte-random-secret
NEWS_CURSOR_TTL_SECONDS=86400
NEWS_FRESHNESS_GRACE_MULTIPLIER=3
NEWS_DETAIL_REVISION_LIMIT=50
NEWS_METADATA_RETENTION_DAYS=730
NEWS_INGESTION_RUN_RETENTION_DAYS=90
NEWS_QUARANTINE_RETENTION_DAYS=30
# 真实 Provider Canary（默认关闭；只输出脱敏字段 manifest）
NEWS_CANARY_ENABLED=false
NEWS_CANARY_PROVIDERS=AKSHARE,GDELT
NEWS_CANARY_SECURITY=000001
# 连续 Canary monitor（显式 Compose profile；默认只观测 AKShare）
NEWS_CANARY_MONITOR_ENABLED=false
NEWS_CANARY_MONITOR_PROVIDERS=AKSHARE
NEWS_CANARY_MONITOR_AKSHARE_INTERVAL_MS=86400000
NEWS_CANARY_MONITOR_GDELT_INTERVAL_MS=900000
NEWS_CANARY_MONITOR_POLL_INTERVAL_MS=60000
NEWS_CANARY_MONITOR_STATE_DIR=storage/news-canary
NEWS_CANARY_MONITOR_ONCE=false
# 新闻性能门禁（只允许隔离 news_perf_* schema 和本机/内网 API）
NEWS_PERF_ENABLED=false
NEWS_PERF_PROFILE=smoke
NEWS_PERF_BASE_URL=http://news-performance-app:3000
NEWS_PERF_ACCESS_TOKEN=replace-with-dedicated-test-user-token
NEWS_PERF_DATASET_ID=news-perf-round2
NEWS_PERF_DATABASE_SCHEMA=news_perf_round2
NEWS_PERF_CURSOR_SECRET=replace-with-at-least-32-byte-performance-secret
NEWS_PERF_SEED_MODE=dry-run
NEWS_PERF_ARTICLE_COUNT=500000
NEWS_PERF_LINKS_PER_ARTICLE=2
NEWS_PERF_STOCK_COUNT=1000
NEWS_PERF_RUN_ID=news-perf-round4-20260806
NEWS_PERF_REPORT_DIR=storage/news-performance
NEWS_PERF_TELEMETRY_INTERVAL_MS=60000
# 新闻故障注入（只允许独立 news_perf_fault_* schema，默认关闭）
NEWS_FAULT_RUN_ID=news-fault-round5-20260806
NEWS_FAULT_DATABASE_SCHEMA=news_perf_fault_round5
NEWS_FAULT_CURSOR_SECRET=replace-with-at-least-32-byte-fault-cursor-secret
NEWS_FAULT_BRIDGE_TOKEN=replace-with-different-at-least-32-byte-fault-bridge-token
NEWS_FAULT_BRIDGE_TIMEOUT_MS=5000
NEWS_FAULT_BRIDGE_DELAY_MS=120000
